# Local development copy: .env (never commit .env)
# Active env vars this phase: HOST, PORT, DATABASE_URL. Other keys are placeholders for later work.

HOST=0.0.0.0
PORT=3000

# PostgreSQL connection string — required when database functionality is used.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Local development example: postgresql://postgres:yourpassword@localhost:5432/industrial_safety_ar
# Never commit a real password. Copy this file to .env and fill in your local values.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/industrial_safety_ar

# Not used yet — authentication (later phase)
JWT_SECRET=replace-with-a-long-random-secret

# Not used yet — certificate integrity (later phase)
CERT_HMAC_SECRET=replace-with-a-long-random-secret

# Not used yet — dashboard / public origins (later phase)
CORS_ORIGIN=http://localhost:5173

# Base URL used to construct certificate verification URLs.
# In production set this to your public domain, e.g. https://sih2026.example.com
PUBLIC_BASE_URL=http://localhost:3000
