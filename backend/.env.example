# Local development copy: .env (never commit .env)
# This phase reads only HOST and PORT. Other keys are placeholders for later work.

HOST=0.0.0.0
PORT=3000

# Not used yet — PostgreSQL (later phase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Not used yet — authentication (later phase)
JWT_SECRET=replace-with-a-long-random-secret

# Not used yet — certificate integrity (later phase)
CERT_HMAC_SECRET=replace-with-a-long-random-secret

# Not used yet — dashboard / public origins (later phase)
CORS_ORIGIN=http://localhost:5173
