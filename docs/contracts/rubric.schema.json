{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sih2026.ps26041.contracts/v1/rubric.schema.json",
  "title": "ScoringRubric",
  "description": "Deterministic scoring rules for a training module, independent of AR rendering. Pair with a module via module_id + content_version. Assessment uses attempt events only (no screenshots, camera frames, or UnityEngine types). Retakes are separate attempts, not overwritten history.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "content_version",
    "pass_percent",
    "max_score",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "JSON contract version. Distinct from content_version."
    },
    "module_id": {
      "type": "string",
      "pattern": "^(fire-explosion-response|gas-confined-space|[a-z][a-z0-9-]{2,61})$",
      "maxLength": 64
    },
    "content_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 32,
      "description": "Must equal the module pack version this rubric scores. Attempts store this value for server re-score."
    },
    "pass_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "multipleOf": 0.01,
      "description": "Pass if (awarded_score / max_score) * 100 >= pass_percent. Same threshold as the paired module."
    },
    "max_score": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "multipleOf": 0.01,
      "description": "Sum of positive point awards available when every required rule is fully met and no penalties apply. Must be > 0."
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "eventType": {
      "$ref": "attempt-event.schema.json#/$defs/eventType"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "step_id",
        "required",
        "event_type",
        "points",
        "award_limit",
        "penalty_points"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "maxLength": 64
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "maxLength": 64
        },
        "required": {
          "type": "boolean",
          "description": "If true, a qualifying event is required to pass the module regardless of total percent (in addition to pass_percent)."
        },
        "event_type": {
          "$ref": "#/$defs/eventType"
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional payload predicates. Omitted keys are ignored. Evaluation is deterministic over events sorted by sequence.",
          "properties": {
            "action_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "target_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "decision_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "outcome": {
              "type": "string",
              "enum": ["success", "failure", "partial", "skipped"]
            },
            "selection_ids": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "ordered_ids": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "numeric_value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operator", "value"],
              "properties": {
                "operator": {
                  "type": "string",
                  "enum": ["gte", "lte", "gt", "lt", "eq"]
                },
                "value": {
                  "type": "number"
                }
              }
            },
            "boolean_value": {
              "type": "boolean"
            }
          }
        },
        "points": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "multipleOf": 0.01,
          "description": "Awarded once per qualifying event, up to award_limit, when the event matches. Zero means the rule is pass/fail only."
        },
        "award_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "Maximum times this rule can award points on one attempt (typically 1)."
        },
        "penalty_points": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "multipleOf": 0.01,
          "description": "Subtracted for each matching penalty event after awards, never exceeding remaining score below 0 at the module level. Use 0 if unused."
        },
        "penalty_event_type": {
          "$ref": "#/$defs/eventType",
          "description": "If present, events of this type that match penalty_match incur penalty_points."
        },
        "penalty_match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["success", "failure", "partial", "skipped"]
            },
            "decision_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "action_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    }
  }
}
